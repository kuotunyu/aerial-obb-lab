      "cx": 200,
      "cy": 100,
      "w": 100,
      "h": 50,
      "conf": 0.9,
      "cls": 1,
      "angle": 1.5707963267948966
    },
    "expected_corners": [
      [225, 50],
      [225, 150],
      [175, 150],
      [175, 50]
    ]
  },
  "output_schema": {
    "name": "output0",
    "dims": [1, 2, 7],
    "expected_length": 14,
    "invalid": [
      {
        "name": "wrong-output-name",
        "results": {"unexpected": {"dims": [1, 2, 7], "data_length": 14}},
        "error": "expected ONNX output named output0"
      },
      {
        "name": "wrong-output-shape",
        "results": {"output0": {"dims": [1, 7, 2], "data_length": 14}},
